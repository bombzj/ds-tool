{
  "name": "mergexls",
  "description": "merge all files in a folder",
  "copyright": "Copyright ©Zesty 2025",
  "main": "mergexls.js",
  "bin": "mergexls.js",
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "assets": [
      "node_modules/sharp/build/Release/**/*",
      "node_modules/@jimp/plugin-print/fonts/**/*"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "pkg": "pkg . --output dist/mergexls.exe --compress GZip"
  },
  "dependencies": {
    "axios": "0.27.2",
    "bwip-js": "^4.0.0",
    "java-properties": "^1.0.2",
    "jimp": "^0.22.10",
    "mysql": "^2.18.1",
    "pdf-lib": "^1.17.1",
    "progress": "^2.0.3",
    "rcedit": "^3.1.0",
    "sharp": "^0.32.4",
    "xlsx": "^0.18.5"
  }
}
