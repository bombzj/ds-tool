const fs = require('fs');
const axios = require('axios');

const domain = 'http://zfjapi.neowulin.com'
const url = domain + '/api/ins/listAvatar'


async function download(file, save) {
    const res = await axios.get(domain + file, {responseType: 'stream'});
    res.data.pipe(fs.createWriteStream(save));
    return new Promise((resolve, reject) => {
        res.data.on('end', () => {
            resolve();
        });
        res.data.on('error', (err) => {
            reject(err);
        });
    });

}

async function doit() {

    const res = await axios.get(url);
    for(let item of res.data.data) {
        const id = item.id;
        const imageFile = item.imageSmall;
        const ext = imageFile.split('.').pop();
        await download(imageFile, `${id}.${ext}`);
        console.log(`Downloaded ${id}.${ext}`);
    }

}

doit();