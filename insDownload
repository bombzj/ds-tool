const fs = require('fs');
const axios = require('axios');

const domain = 'http://zfjapi.neowulin.com'
const url = domain + '/api/ins/'


async function download(file, save) {
    // create path for file : save
    if(file.length === 0) return;
    let path = save.split('/');
    path.pop();
    path = path.join('/');
    if (!fs.existsSync(path))
        fs.mkdirSync(path, {recursive: true});

    const res = await axios.get(domain + file, {responseType: 'stream'});
    res.data.pipe(fs.createWriteStream(save));
    return new Promise((resolve, reject) => {
        res.data.on('end', () => {
            resolve();
        });
        res.data.on('error', (err) => {
            reject(err);
        });
    });

}

